#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESCAPE      &kp N1    &kp N2     &kp N3         &kp N4     &kp N5  &kp N6                                                               &mo 1              &kp N7  &kp N8    &kp N9        &kp N0     &kp MINUS         &kp BACKSPACE
&kp TAB         &kp Q     &kp W      &kp E          &kp R      &kp T   &kp SPACE                                                            &kp DOUBLE_QUOTES  &kp Y   &kp U     &kp I         &kp O      &kp P             &kp EQUAL
&kp TAB         &kp A     &kp S      &kp D          &kp F      &kp G   &kp N6     &kp LCTRL  &kp ENTER          &kp DELETE     &kp RG(TAB)  &kp SINGLE_QUOTE   &kp H   &kp J     &kp K         &kp L      &kp SEMI          &kp ENTER
&kp LEFT_SHIFT  &kp Z     &kp X      &kp C          &kp V      &kp B                         &kp LALT           &kp BACKSPACE                                  &kp N   &kp M     &kp UP_ARROW  &kp COMMA  &kp DOT           &kp SLASH
&kp LGUI        &kp LALT  &kp LCTRL  &kp BACKSPACE  &kp GRAVE          &kp LGUI   &mo 1      &kp LG(SPACE)      &kp ENTER      &kp TAB      &kp SPACE                  &kp LEFT  &kp DOWN      &kp RIGHT  &kp LEFT_BRACKET  &kp RIGHT_BRACKET
            >;
        };

        layer_fn {
            bindings = <
&bt BT_CLR    &kp F1                    &kp F2         &kp F3         &kp F4         &kp F5  &kp F6                                            &none        &kp F7  &kp F8            &kp F9             &kp F10  &kp F11       &kp F12
&bt BT_SEL 0  &kp LA(LC(SINGLE_QUOTE))  &kp LA(F7)     &kp BACKSPACE  &kp LS(F6)     &trans  &bootloader                                       &bootloader  &trans  &trans            &trans             &trans   &trans        &bt BT_SEL 0
&bt BT_SEL 1  &kp LC(LA(LG(B)))         &kp LA(LG(B))  &kp LC(SPACE)  &kp ENTER      &trans  &kp F6       &trans  &trans      &tog 0  &trans   &trans       &trans  &kp SINGLE_QUOTE  &kp DOUBLE_QUOTES  &trans   &trans        &bt BT_SEL 1
&trans        &kp LG(BACKSLASH)         &trans         &kp SPACE      &kp LC(ENTER)  &trans                       &none       &none                         &trans  &none             &none              &tog 2   &none         &none
&trans        &trans                    &kp PAGE_UP    &trans         &trans                 &trans       &trans  &trans      &trans  &kp DEL  &trans               &trans            &trans             &trans   &kp CAPSLOCK  &kp BSLH
            >;
        };
    };
};
